@model IEnumerable<WebApp.Models.AuditoriaModel>

@{
    ViewData["Title"] = "Ver auditorías";
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>¡Atención!</strong> @ViewBag.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="page-header">
    <h1><span class="page-icon"><i class="bi bi-clock-history"></i></span> Ver Auditorías</h1>
    <div class="page-actions">
        <a asp-controller="Prestamo" asp-action="Details" asp-route-id="@Model.FirstOrDefault().PrestamoId" class="btn btn-primary"><i class="bi bi-eye"></i> Ver detalle de préstamo</a>
        <a asp-controller="Prestamo" asp-action="PrestamosPorCoordinador" class="btn btn-secondary">Volver</a>
    </div>
</div>

<div class="table-responsive-wrapper">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Fecha</th>
                    <th>Socio</th>
                    <th>Acción </th>
                </tr>
            </thead>
            <tbody>
@foreach (var item in Model) {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@item.Prestamo.Usuario.Nombre @item.Prestamo.Usuario.Apellido</td>
                    <td>
                        @if (item.Accion.ToString() == "Devolucion")
                        {
                            <span class="badge bg-success">@item.Accion.ToString()</span>
                        }
                        else
                        {
                            <span class="badge bg-info">@item.Accion.ToString()</span>
                        }
                    </td>
                </tr>
}
            </tbody>
        </table>
    </div>
</div>
