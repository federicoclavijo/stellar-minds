@model WebApp.Models.ListadoSociosXTelescopioModel

@{
    ViewData["Title"] = "Listado de socios por telescopio";
}

<div class="page-header">
    <h1><span class="page-icon"><i class="bi bi-people"></i></span> Listado de Socios por Telescopio</h1>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="ListadoSociosXTelescopio" method="post">
            <div class="form-group mb-0">
                <label class="form-label"><i class="bi bi-brightness-high text-secondary"></i> Telescopio:</label>
                <select asp-for="TelescopioId" class="form-control" onchange="this.form.submit()">
                    <option value="">-- Seleccione un equipo --</option>
                    @foreach (var equipo in Model.Telescopios)
                    {
                        <option value="@equipo.Id">@equipo.Marca - @equipo.Modelo</option>
                    }
                </select>
            </div>
        </form>
    </div>
</div>
@if(Model.Socios != null && Model.Socios.Any())
{
    <div class="table-responsive-wrapper">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Dirección</th>
                        <th>Teléfono</th>
                        <th>Email</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Socios)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Nombre</td>
                            <td>@item.Apellido</td>
                            <td>@item.Direccion</td>
                            <td>@item.Telefono</td>
                            <td>@item.Email</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (Model.TelescopioId != null)
{
    <div class="alert alert-info">
        No hay socios que hayan solicitado un préstamo con el telescopio seleccionado.
    </div>
}
