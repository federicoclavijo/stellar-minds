@model WebApp.Models.ListadoPrestamosXSocioModel

@{
    ViewData["Title"] = "Listado de préstamos por socio";
}

<div class="page-header">
    <h1><span class="page-icon"><i class="bi bi-person-lines-fill"></i></span> Listado de Préstamos por Socio</h1>
</div>

@if (!String.IsNullOrWhiteSpace(ViewBag.Mensaje))
{
    <div class="alert alert-success">
        @ViewBag.Mensaje
    </div>
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="ListadoPrestamosXSocio" method="post">
            <div class="form-group mb-0">
                <label class="form-label">Socio:</label>
                <select asp-for="UsuarioId" class="form-control" onchange="this.form.submit()">
                    <option value="">-- Seleccione un socio --</option>
                    @foreach (var socio in Model.Socios)
                    {
                        <option value="@socio.Id">@socio.Nombre - @socio.Apellido</option>
                    }
                </select>
            </div>
        </form>
    </div>
</div>

@if (Model.Prestamos != null && Model.Prestamos.Any())
{
    <div class="table-responsive-wrapper">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Usuario ID</th>
                        <th>Fecha deInicio</th>
                        <th>Fecha de Fin</th>
                        <th>Estado</th>
                        <th>Telescopio ID</th>
                        <th>Montura ID</th>
                        <th>Camara ID</th>
                        <th>Ocular ID</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Prestamos)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.Id)</td>
                            <td>@Html.DisplayFor(modelItem => item.UsuarioId)</td>
                            <td>@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                            <td>@item.FechaFin.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.Estado == LogicaNegocio.Enums.EstadoPrestamo.DEVUELTO)
                                {
                                    <span class="badge bg-success">@Html.DisplayFor(modelItem => item.Estado)</span>
                                }
                                else
                                {
                                    <span class="badge bg-info">@Html.DisplayFor(modelItem => item.Estado)</span>
                                }
                            </td>
                            <td>@Html.DisplayFor(modelItem => item.TelescopioId)</td>
                            <td>@Html.DisplayFor(modelItem => item.MonturaId)</td>
                            <td>@Html.DisplayFor(modelItem => item.CamaraId)</td>
                            <td>@Html.DisplayFor(modelItem => item.OcularId)</td>
                            <td>
                                <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-dark btn-sm"><i class="bi bi-arrow-return-left"></i> Devolver</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (Model.UsuarioId != null)
{
    <div class="alert alert-info">
        No hay préstamos vigentes para el socio seleccionado.
    </div>
}
