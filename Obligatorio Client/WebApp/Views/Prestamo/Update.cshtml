@model WebApp.Models.PrestamoModel

@{
    ViewData["Title"] = "Devolver";
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>¡Atención!</strong> @ViewBag.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="auth-shell" style="min-height:40vh;">
    <div class="auth-card text-center">
        <div class="auth-icon" style="background:var(--warning-soft); color:var(--warning);">
            <i class="bi bi-arrow-return-left"></i>
        </div>
        <h1>¿Seguro que quieres devolver este equipo?</h1>

        <form asp-action="Update" class="d-flex justify-content-center gap-2 mt-3">
            <a asp-action="Index" class="btn btn-secondary">Volver</a>
            <input type="submit" value="Devolver" class="btn btn-danger" />
        </form>
    </div>
</div>
