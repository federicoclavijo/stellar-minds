
@{
    ViewData["Title"] = "Inicio";
}

<div class="container">
    <div class="row justify-content-center align-items-center" style="min-height:70vh;">
        <div class="col-md-8 text-center">
            <div class="card shadow-sm border-0">
                <div class="card-body p-5">
                    <div class="auth-icon" style="margin-bottom:1.25rem;">
                        <i class="bi bi-stars"></i>
                    </div>
                    <h1 class="display-4 mb-3">
                        ¡ Bienvenido @ViewBag.Nombre !
                    </h1>

                    <p class="lead text-muted">
                        Te damos la bienvenida al sistema de gestión de StellarMinds.
                    </p>

                    <hr />

                    <p class="mb-0">
                        Utiliza el menú de navegación para acceder a las funcionalidades disponibles según tu perfil.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

