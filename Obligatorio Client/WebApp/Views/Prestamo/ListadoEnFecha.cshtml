@model WebApp.Models.PrestamoFiltroViewModel

@{
    ViewData["Title"] = "Listado de Préstamos filtrado";
}

<div class="page-header">
    <h1><span class="page-icon"><i class="bi bi-calendar3"></i></span> Listado de Préstamos filtrado</h1>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="ListadoEnFecha" method="post">
            <div class="row align-items-end g-3">
                <div class="col-md-3">
                    <div class="form-group mb-0">
                        <label asp-for="Fecha" class="form-label">Fecha:</label>
                        <input asp-for="Fecha" type="month" class="form-control" required />
                    </div>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel"></i> Filtrar</button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model.Prestamos != null && Model.Prestamos.Any())
{
    <h4 class="mb-3">Resultados</h4>
    <div class="table-responsive-wrapper">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Usuario</th>
                        <th>Telescopio</th>
                        <th>Montura</th>
                        <th>Cámara</th>
                        <th>Ocular</th>
                        <th>Fecha Inicio</th>
                        <th>Fecha Fin</th>
                        <th>Atrasado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var prestamo in Model.Prestamos)
                    {
                        <tr>
                            <td>@prestamo.Usuario.Nombre</td>
                            <td>@(prestamo.Telescopio != null ? prestamo.Telescopio.Marca + " - " + prestamo.Telescopio.Modelo : "Equipo eliminado")</td>
                            <td>@(prestamo.Montura != null ? prestamo.Montura.Marca + " - " + prestamo.Montura.Modelo : "Equipo eliminado")</td>
                            <td>@(prestamo.Camara != null ? prestamo.Camara.Marca + " - " + prestamo.Camara.Modelo : "-")</td>
                            <td>@(prestamo.Ocular != null ? prestamo.Ocular.Marca + " - " + prestamo.Ocular.Modelo : "-")</td>
                            <td>@prestamo.FechaInicio.ToString("dd/MM/yyyy")</td>
                            <td>@prestamo.FechaFin.ToString("dd/MM/yyyy")</td>
                            @if(prestamo.Estado == LogicaNegocio.Enums.EstadoPrestamo.EN_PRESTAMO && prestamo.FechaFin < DateTime.Now)
                            {
                                <td><span class="badge bg-danger">Sí</span></td>
                            }
                            else if (prestamo.Estado == LogicaNegocio.Enums.EstadoPrestamo.EN_PRESTAMO && prestamo.FechaFin > DateTime.Now)
                            {
                                <td><span class="badge bg-success">No</span></td>
                            }
                            else
                            {
                                <td><span class="badge bg-success">Devuelto</span></td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (Model.Fecha.HasValue)
{
    <div class="alert alert-info">
        No hay préstamos en el mes y año seleccionado.
    </div>
}
